{
  "name": "returns",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:stage": "vite --mode stage",
    "postinstall": "node node_modules/frontend-ai-rules/scripts/sync-rules.js && node scripts/customize-ai-rules-index.mjs",
    "sync:ai-rules": "node node_modules/frontend-ai-rules/scripts/sync-rules.js && node scripts/customize-ai-rules-index.mjs",
    "check:cors": "node scripts/ensure-cors-origin.mjs",
    "build:watch": "node scripts/ensure-cors-origin.mjs --mode dev && tsc -b && vite build --mode dev --watch",
    "build:dev": "node scripts/ensure-cors-origin.mjs --mode dev && tsc -b && vite build --mode dev",
    "build:stage": "node scripts/ensure-cors-origin.mjs --mode stage && tsc -b && vite build --mode stage",
    "build:prod": "node scripts/ensure-cors-origin.mjs --mode prod && tsc -b && vite build --mode prod",
    "build": "node scripts/ensure-cors-origin.mjs --mode prod && tsc -b && vite build --mode prod",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@emporix/api-calls": "1.2.1",
    "@emporix/component-library": "2.9.3",
    "@hookform/resolvers": "^3.10.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "axios": "^1.18.1",
    "classnames": "^2.5.1",
    "i18next": "^26.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.7.4",
    "react-icons": "^5.4.0",
    "react-router": "^7.13.1",
    "uuid": "^14.0.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "frontend-ai-rules": "git+https://github.com/emporix/frontend-ai-rules.git#md-module-migration",
    "globals": "^15.15.0",
    "prettier": "3.5.0",
    "sass": "^1.101.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
